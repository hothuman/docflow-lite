{
  "name": "DocFlow Industrial Atelier",
  "version": 1,
  "status": "website implemented; Qt mapping is a future specification",
  "primitive": {
    "bg": "#111310",
    "surface": "#1b1e1a",
    "raised": "#242923",
    "text": "#f1f3eb",
    "muted": "#b0b8aa",
    "border": "#363d32",
    "accent": "#c2e88a",
    "accent_text": "#172014",
    "focus": "#d7f6af",
    "success": "#b7e19b",
    "warning": "#efc98b",
    "danger": "#ffb4a4",
    "control_border": "#7c8871"
  },
  "semantic": {
    "canvas": "{primitive.bg}",
    "panel": "{primitive.surface}",
    "text.primary": "{primitive.text}",
    "text.secondary": "{primitive.muted}",
    "action.primary": "{primitive.accent}",
    "action.onPrimary": "{primitive.accent_text}",
    "focus.ring": "{primitive.focus}",
    "border.decorative": "{primitive.border}",
    "border.control": "{primitive.control_border}",
    "feedback.error": "{primitive.danger}"
  },
  "component": {
    "button": {
      "height": 50,
      "radius": 6,
      "paddingX": 22,
      "fontSize": 14,
      "focusWidth": 3,
      "focusOffset": 5
    },
    "panel": {
      "radius": 8,
      "borderWidth": 1
    },
    "layout": {
      "maxWidth": 1280,
      "breakpoints": [
        560,
        860,
        1100
      ],
      "space": [
        4,
        8,
        12,
        16,
        20,
        24,
        32,
        40,
        48,
        64,
        80,
        96
      ]
    },
    "typography": {
      "family": "Manrope",
      "fallback": "Segoe UI",
      "body": 16,
      "lineHeight": 1.7,
      "weights": [
        400,
        550,
        600,
        750
      ]
    }
  },
  "qt_palette_proposal": {
    "Window": "{primitive.bg}",
    "WindowText": "{primitive.text}",
    "Base": "{primitive.surface}",
    "AlternateBase": "{primitive.raised}",
    "Text": "{primitive.text}",
    "Button": "{primitive.raised}",
    "ButtonText": "{primitive.text}",
    "Highlight": "{primitive.accent}",
    "HighlightedText": "{primitive.accent_text}",
    "PlaceholderText": "{primitive.muted}"
  }
}
