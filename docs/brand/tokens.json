{
  "name": "DocFlow Industrial Contrast",
  "version": 2,
  "status": "owner-approved reference A; website implementation; Qt mapping is a future specification",
  "primitive": {
    "bg": "#090f12",
    "surface": "#121c20",
    "raised": "#172429",
    "text": "#f5f8f2",
    "muted": "#b3c0b7",
    "border": "#34434a",
    "accent": "#cbff55",
    "accent_text": "#111b10",
    "focus": "#cbff55",
    "success": "#7fe6d0",
    "warning": "#efc98b",
    "danger": "#ffb4a4",
    "control_border": "#667977"
  },
  "semantic": {
    "canvas": "{primitive.bg}",
    "panel": "{primitive.surface}",
    "text.primary": "{primitive.text}",
    "text.secondary": "{primitive.muted}",
    "action.primary": "{primitive.accent}",
    "action.onPrimary": "{primitive.accent_text}",
    "focus.ring": "{primitive.focus}",
    "border.decorative": "{primitive.border}",
    "border.control": "{primitive.control_border}",
    "feedback.error": "{primitive.danger}",
    "paper.canvas": "{paper.bg}",
    "paper.text": "{paper.text}",
    "paper.secondary": "{paper.muted}",
    "paper.focus": "{paper.focus}",
    "paper.error": "{paper.error}"
  },
  "component": {
    "button": {
      "height": 56,
      "radius": 0,
      "paddingX": 24,
      "fontSize": 14,
      "focusWidth": 3,
      "focusOffset": 4
    },
    "panel": {
      "radius": 0,
      "borderWidth": 1
    },
    "layout": {
      "maxWidth": 1400,
      "breakpoints": [
        380,
        680,
        860,
        1000,
        1100
      ],
      "space": [
        4,
        8,
        12,
        16,
        20,
        24,
        32,
        40,
        48,
        64,
        80,
        100
      ]
    },
    "typography": {
      "family": "Segoe UI",
      "fallback": "Manrope",
      "body": 16,
      "lineHeight": 1.7,
      "weights": [
        400,
        650,
        750,
        820
      ],
      "heroMax": 106,
      "heroLineHeight": 0.96,
      "heroTracking": "-.077em"
    }
  },
  "qt_palette_proposal": {
    "Window": "{primitive.bg}",
    "WindowText": "{primitive.text}",
    "Base": "{primitive.surface}",
    "AlternateBase": "{primitive.raised}",
    "Text": "{primitive.text}",
    "Button": "{primitive.raised}",
    "ButtonText": "{primitive.text}",
    "Highlight": "{primitive.accent}",
    "HighlightedText": "{primitive.accent_text}",
    "PlaceholderText": "{primitive.muted}"
  },
  "paper": {
    "bg": "#f4f3e9",
    "text": "#1b2524",
    "muted": "#526458",
    "accent": "#31511e",
    "focus": "#31511e",
    "error": "#a12a22",
    "control_border": "#68776d"
  }
}
